diff --git a/apps/checkout/frontend-performance/InvoiceTotals.tsx b/apps/checkout/frontend-performance/InvoiceTotals.tsx
index e69de29..b8a8a08 100644
--- a/apps/checkout/frontend-performance/InvoiceTotals.tsx
+++ b/apps/checkout/frontend-performance/InvoiceTotals.tsx
@@ -0,0 +1,6 @@
+export function InvoiceTotals({ invoices }) {
+  const visibleInvoices = invoices
+    .filter((invoice) => invoice.status !== "void")
+    .sort((left, right) => right.total - left.total);
+  return visibleInvoices.map((invoice) => invoice.total).join(", ");
+}
