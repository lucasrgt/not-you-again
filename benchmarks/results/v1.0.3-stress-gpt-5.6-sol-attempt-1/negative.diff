diff --git a/apps/tenancy/UserCache.ts b/apps/tenancy/UserCache.ts
index e69de29..5ccbf6e 100644
--- a/apps/tenancy/UserCache.ts
+++ b/apps/tenancy/UserCache.ts
@@ -0,0 +1,12 @@
+const users = new Map<string, User>();
+
+const key = (organizationId: string, userId: string) =>
+  `${organizationId}:${userId}`;
+
+export function cacheUser(organizationId: string, user: User) {
+  users.set(key(organizationId, user.id), user);
+}
+
+export function getUser(organizationId: string, userId: string) {
+  return users.get(key(organizationId, userId));
+}
