--- a/apps/scheduler/infrastructure-reliability/retry.py
+++ b/apps/scheduler/infrastructure-reliability/retry.py
@@ -0,0 +1,12 @@
+import random
+import time
+
+
+def deliver(send):
+    for attempt in range(4):
+        try:
+            return send()
+        except TemporaryError:
+            if attempt == 3:
+                raise
+            time.sleep((2**attempt) * 0.1 + random.uniform(0, 0.05))
